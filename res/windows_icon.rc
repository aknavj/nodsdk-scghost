#include <winver.h>
#include "version.h"

// GLFW also uses this named resource for window and taskbar icons.
GLFW_ICON ICON "embrace.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NODSDK_VERSION_NUMBER
 PRODUCTVERSION NODSDK_VERSION_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenNod SDK & StaRev contributors"
            VALUE "FileDescription", "OpenNOD " NODSDK_RESOURCE_NAME
            VALUE "FileVersion", NODSDK_FILE_VERSION_STRING
            VALUE "InternalName", NODSDK_RESOURCE_NAME
            VALUE "OriginalFilename", NODSDK_RESOURCE_NAME ".exe"
            VALUE "ProductName", "OpenNOD SDK"
            VALUE "ProductVersion", NODSDK_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (C) 2026, OpenNod SDK & StaRev contributors"
            VALUE "Comments", "http://github.com/aknavj/nodsdk-scghost"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
